# Smart Campus Lost & Found Environment Configuration

# GEMINI_API_KEY: Optional AI Studio integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current applet URL
APP_URL="MY_APP_URL"

# Firebase Cloud Firestore & Auth Config (Optional - App includes live full-stack Express backend by default)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Payment Gateway Sandbox (e.g. Razorpay test keys)
# If empty, the platform seamlessly runs with the certified Campus Demo Payment Gateway!
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
